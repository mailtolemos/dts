# --- Required ---
DATABASE_URL="postgresql://dts:dts@localhost:5432/dts?schema=public"
GROQ_API_KEY=""

# --- Pyth ---
# Public Hermes works without a key (rate-limited). Set this to use Pyth Pro.
PYTH_API_KEY=""
PYTH_HERMES_URL="https://hermes.pyth.network"

# --- Secondary providers (optional; without them we use mocks) ---
CRYPTOPANIC_API_KEY=""
FRED_API_KEY=""
POLYGON_API_KEY=""
COINGECKO_API_KEY=""

# --- Auth ---
AUTH_ENABLED="0"           # "1" to enable NextAuth magic links
DTS_USER_EMAIL="you@example.com"   # used in single-user mode

# --- AI ---
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"

# --- Misc ---
NODE_ENV="development"
LOG_LEVEL="info"
